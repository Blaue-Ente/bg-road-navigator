# Copy to .env.local (or set in Railway / Vercel / Cursor secrets).
# Leave unused vars blank or omit them — empty NEXT_PUBLIC_* is treated as unset.
# After editing, restart `npm run dev`. Check: GET /api/config/status

# --- Public site URL (Auth redirects + deploy docs; not required for local browse)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Map (optional — default: Carto Dark Matter)
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Supabase (required for login, favorites, saved routes, community writes)
# 1) Create project at https://supabase.com/dashboard
# 2) Paste URL + anon key below
# 3) Run supabase/apply_all.sql once in SQL Editor
# 4) Auth → URL Configuration: add NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserved — unused by the app today (anon key + RLS cover client/server routes)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Borders (recommended, free)
# https://nakordoni.eu/en/developers
NAKORDONI_API_KEY=
# https://api.windy.com/webcams
WINDY_WEBCAMS_API_KEY=

# --- Fuel / traffic / EV (optional freemium)
# https://developer.tomtom.com/
TOMTOM_API_KEY=
# https://openchargemap.org/site/develop
OPENCHARGE_API_KEY=

# --- AI trip planner (optional — heuristic fallback always works)
# https://build.nvidia.com/
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Self-hosted routing / geocoding (optional — public defaults work for light use)
OSRM_API_URL=
GEOCODING_API_URL=
