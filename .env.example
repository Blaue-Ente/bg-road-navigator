# Copy to .env.local (or set in Railway / Vercel / Cursor secrets).
# Leave unused vars blank or omit them — empty NEXT_PUBLIC_* is treated as unset.
# After editing, restart `npm run dev`. Check: GET /api/config/status
#
# OPERATOR PRIORITY
# Must (accounts + production URL + live borders):
#   DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, NEXT_PUBLIC_APP_URL, NAKORDONI_API_KEY
# Should (map POIs):
#   TOMTOM_API_KEY, OPENCHARGE_API_KEY, WINDY_WEBCAMS_API_KEY
# Optional:
#   NVIDIA_API_KEY, OSRM_API_URL, GEOCODING_API_URL, OCI_GEO_BASE_URL, OCI_GEO_API_KEY, NEXT_PUBLIC_MAP_STYLE_URL
# No key needed:
#   MapLibre/Carto, public OSRM, Nominatim, Open-Meteo, Frankfurter FX, Overpass (nearby hospitals)

# --- Accounts (Better Auth on Neon Postgres)
# Apply drizzle/0001_better_auth_and_community.sql once. See docs/SETUP.md.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Public site URL (auth links; not required for local browse)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional social sign-in. A button appears only when both keys exist.
# Google: docs/SETUP.md. Redirect: https://bg-road-navigator.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: paid Apple Developer account. Redirect: https://bg-road-navigator.vercel.app/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- Borders (recommended, free)
# https://nakordoni.eu/en/developers
NAKORDONI_API_KEY=
# Country ids whose markets we may call. Default 12,5,15,19 (BG, RO, MK, GR).
# A checkpoint is fetched only when both sides are listed. Serbia is 13, Turkey is 14.
# NAKORDONI_LICENSED_MARKETS=12,5,15,19
# One secret for both Vercel crons. Sent as Authorization: Bearer <CRON_SECRET>
# (x-cron-secret also works). Hobby schedules, both once a day:
#   /api/cron/nakordoni  20 5 * * *   (Pro may use */15 * * * *)
#   /api/cron/warm-geo   0 8 * * *    (Pro may use */10 * * * *)
# Nakordoni refresh spends the daily quota, so production returns 401 until this
# is set. Warm-geo only pings Valhalla and Photon and stays open when unset.
CRON_SECRET=
# https://api.windy.com/webcams
WINDY_WEBCAMS_API_KEY=

# --- Fuel / traffic / EV (optional freemium)
# https://developer.tomtom.com/
TOMTOM_API_KEY=
# https://openchargemap.org/site/develop
OPENCHARGE_API_KEY=
# Germany station prices. Omit to leave German prices unknown.
# https://creativecommons.tankerkoenig.de/
TANKERKOENIG_API_KEY=
# Fuelo API v2 — country average prices only (free plan). https://developers.fuelo.net/
# FUELO_API_KEY=
# Optional raw Cherna Pista GeoJSON overlay. Clustered BG hotspots load from
# lib/hotspots/data/cherna and do not need this flag.
# CHERNA_PISTA_LAYER=1

# --- AI trip planner (optional — heuristic fallback always works)
# https://build.nvidia.com/
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Operator / admin UI (optional — hides /setup from the main menu when unset)
# NEXT_PUBLIC_OPERATOR_MODE=true
# Or open any page with ?operator=1, or tap the product name 7 times on Profile.

# --- Self-hosted routing / geocoding / map style (optional — public defaults work)
# Valhalla + Photon. Both required. The key stays on the server (header X-API-Key).
# Unset either one and routing/geocoding use public OSRM and Nominatim again.
OCI_GEO_BASE_URL=
OCI_GEO_API_KEY=
# Corridor POI. Defaults to OCI_GEO_BASE_URL + /poi and reuses OCI_GEO_API_KEY.
# OCI_POI_BASE_URL=
# Public Overpass is off unless this last-resort flag is 1, true, or yes.
# POI_OVERPASS_FALLBACK=
# Optional override for the European Commission Weekly Oil Bulletin file.
# OIL_BULLETIN_URL=
# Optional host overrides for the public fallbacks.
OSRM_API_URL=
GEOCODING_API_URL=
NEXT_PUBLIC_MAP_STYLE_URL=

# AI text (trip explanation). NVIDIA's free NIM endpoint is the default, so
# NVIDIA_API_KEY alone is enough. For another OpenAI-compatible provider set
# all three. Leave empty to keep the rule-based text only.
# AI_API_KEY=
# AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# AI_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# Extra request fields as JSON, e.g. to stop a reasoning model thinking first
# (otherwise it can spend the whole token budget and return an empty answer):
# Run on OpenRouter instead (uses OPENROUTER_API_KEY; AI_MODEL defaults to
# particle-ai/particle-1:free, a free model that answered in about 2 s):
# AI_PROVIDER=openrouter
# AI_EXTRA_BODY={"reasoning":{"enabled":false}}
# AI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Trip notices when the page is closed (web push). Generate once with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Ping GET /api/cron/push-due every minute (Vercel's free cron is daily).

# Where to sleep: Tripadvisor Terra ratings (Discover plan, key from
# tripadvisor.com/developers) and Booking.com partner links. The first 1,000
# returned places are free, then about 0.015 USD each: set a daily budget in the
# Tripadvisor dashboard too. Results are never cached (their policy).
# TRIPADVISOR_API_KEY=
# Places requested per search (1-20, default 6) and per-server daily ceiling (default 200).
# TRIPADVISOR_RESULT_SIZE=6
# TRIPADVISOR_DAILY_LIMIT=200
# BOOKING_AFFILIATE_ID=

# HERE Traffic (second source of road incidents). Server-side only.
# HERE_API_KEY=
# Seconds a HERE tile (1 degree) is reused (default 300).
# HERE_CACHE_SECONDS=300
# Seconds a TomTom incident tile is shared between drivers (default 120).
# TRAFFIC_CACHE_SECONDS=120

# Shared caches that save provider calls (see AGENTS.md "Shared cache").
# ROUTESTACK_CACHE_MINUTES=60       # hotel prices per city, night and party; 0 = off
# OPENCHARGE_CACHE_MINUTES=360      # open data, kept in Neon
# TOMTOM_PLACES_CACHE_MINUTES=30    # memory only; TomTom's terms do not clearly allow storing
# TANKERKOENIG_CACHE_MINUTES=10     # open data, kept in Neon

# RouteStack hotel search (partner API). Start with the sandbox keys and
# https://evolvemcp.routestack.ai, then switch to the live ones.
# ROUTESTACK_API_KEY=
# ROUTESTACK_API_SECRET=
# ROUTESTACK_BASE_URL=https://mcp.routestack.ai
