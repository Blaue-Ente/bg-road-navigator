# Copy to .env.local (or set in Railway / Vercel / Cursor secrets).
# Leave unused vars blank or omit them — empty NEXT_PUBLIC_* is treated as unset.
# After editing, restart `npm run dev`. Check: GET /api/config/status
#
# OPERATOR PRIORITY
# Must (accounts + production URL + live borders):
#   DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, NEXT_PUBLIC_APP_URL, NAKORDONI_API_KEY
# Should (map POIs):
#   TOMTOM_API_KEY, OPENCHARGE_API_KEY, WINDY_WEBCAMS_API_KEY
# Optional:
#   NVIDIA_API_KEY, OSRM_API_URL, GEOCODING_API_URL, NEXT_PUBLIC_MAP_STYLE_URL
# No key needed:
#   MapLibre/Carto, public OSRM, Nominatim, Open-Meteo, Frankfurter FX, Overpass (nearby hospitals)

# --- Accounts (Better Auth on Neon Postgres)
# Apply drizzle/0001_better_auth_and_community.sql once. See docs/SETUP.md.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Public site URL (auth links; not required for local browse)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional social sign-in. A button appears only when both keys exist.
# Google: docs/SETUP.md. Redirect: https://bg-road-navigator.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: paid Apple Developer account. Redirect: https://bg-road-navigator.vercel.app/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- Borders (recommended, free)
# https://nakordoni.eu/en/developers
NAKORDONI_API_KEY=
# https://api.windy.com/webcams
WINDY_WEBCAMS_API_KEY=

# --- Fuel / traffic / EV (optional freemium)
# https://developer.tomtom.com/
TOMTOM_API_KEY=
# https://openchargemap.org/site/develop
OPENCHARGE_API_KEY=

# --- AI trip planner (optional — heuristic fallback always works)
# https://build.nvidia.com/
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Operator / admin UI (optional — hides /setup from the main menu when unset)
# NEXT_PUBLIC_OPERATOR_MODE=true
# Or open any page with ?operator=1, or tap the product name 7 times on Profile.

# --- Self-hosted routing / geocoding / map style (optional — public defaults work)
OSRM_API_URL=
GEOCODING_API_URL=
NEXT_PUBLIC_MAP_STYLE_URL=
